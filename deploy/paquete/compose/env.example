# Configuración de la instalación. Copie este archivo a compose/.env y ajústelo.
# Aquí NO van contraseñas ni claves: se guardan como archivos en secretos/ (ver secretos/LEEME.md).
# Los valores marcados «A DEFINIR» los debe confirmar EsSalud; no los invente.

# --- Versión del paquete (no cambiar a mano: la fija VERSION) ---
APP_VERSION=1.0.0-rc.2
FRONTEND_IMAGE=essalud/frontend
BACKEND_IMAGE=essalud/backend
POSTGRES_IMAGE=postgres:17.11-bookworm

# --- Nombre del proyecto de Docker Compose (contenedores, redes y volumen) ---
PROYECTO=papeletas

# --- Escenario de base de datos ---
# A = PostgreSQL en contenedor (volumen propio, sin puertos publicados).
# B = PostgreSQL existente de EsSalud (DB_HOST/DB_PORT del DBA; ver documentacion/base-de-datos.md).
ESCENARIO=A
DB_NAME=papeletas
DB_USER=papeletas_app
DB_OWNER_USER=papeletas_admin
# Solo escenario B (A DEFINIR por el DBA). En A se ignoran.
# DB_HOST=
# DB_PORT=5432

# --- Acceso web y HTTPS ---
# TLS=institucional: EsSalud pone su proxy HTTPS delante y reenvía a este servidor (HTTP_BIND/HTTP_PORT).
# TLS=propio: este paquete termina HTTPS (compose.prod.tls.yml) con el certificado de secretos/tls.crt y tls.key.
TLS=institucional
# Interfaz y puerto del frontend. Deje 127.0.0.1 si el proxy está en este mismo servidor.
# Si el proxy institucional está en otra máquina, ponga la IP interna de este servidor (A DEFINIR) y
# limite el puerto en el cortafuegos a la IP del proxy.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Solo con TLS=propio:
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
HTTP_REDIRECT_PORT=80
# Saltos de proxy de confianza ante el backend: 2 = proxy HTTPS + Nginx del frontend.
# Si hay otro proxy más delante (balanceador), súmelo. Nunca más saltos de los reales.
TRUST_PROXY=2

# --- Sesión y seguridad ---
JWT_EXPIRES_IN=1h
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUDIT_ENABLED=true
ACCESS_LOG_ENABLED=true

# --- Base de datos: límites (no bajar DB_CONNECTION_TIMEOUT_MS de 10000; incidencia VM1) ---
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=18000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# --- Copias de seguridad ---
# Carpeta local de copias (relativa a la carpeta del paquete o absoluta) y días de retención.
# El destino EXTERNO lo define EsSalud (A DEFINIR): copie allí los tres archivos de cada copia.
COPIAS_DIR=copias
COPIAS_DIAS=14

# --- Recursos y registros ---
TZ=America/Lima
FRONTEND_MEMORY=128m
BACKEND_MEMORY=256m
DB_MEMORY=512m
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
