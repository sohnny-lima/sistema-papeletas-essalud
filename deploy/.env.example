# Copiar a .env; no escribir secretos aquí. Rutas relativas a deploy/.
APP_VERSION=1.0.0-rc.2
VCS_REF=sin-revision
SOURCE_URL=entrega-essalud
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
TZ=America/Lima
# B: nombre o IP del servidor existente. A sobrescribe host/puerto a db:5432.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=papeletas
DB_USER=papeletas_app
# Propietario: solo migraciones, altas administrativas y copias.
DB_OWNER_USER=papeletas_admin
DB_OWNER_PASSWORD_PATH=./secretos/db_owner_password
DB_PASSWORD_PATH=./secretos/db_password
JWT_SECRET_PATH=./secretos/jwt_secret
# VM1: con 3000, una conexión nueva lenta tras inactividad daba 503 con la base sana.
DB_CONNECTION_TIMEOUT_MS=10000
# Solo pool de la API: sentencia, espera del cliente y transacción abandonada (ms).
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=18000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# Registro JSON de acceso sin query string, cuerpo, cabeceras ni IP.
ACCESS_LOG_ENABLED=true
JWT_EXPIRES_IN=1h
# 1: Nginx directo; 2: proxy institucional confiable delante, sin acceso directo.
TRUST_PROXY=1
# Opcional, solo si otro origen de desarrollo necesita CORS.
CLIENT_URL=
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUDIT_ENABLED=true
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
FRONTEND_MEMORY=128m
BACKEND_MEMORY=256m
DB_MEMORY=512m
# Imagen fijada por defecto; etiqueta local verificada para traslado sin RepoDigests.
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:839fbb5a4942a7758dd93e18b42ea5649807491a0545b5eeeb8f0b8bb11857a5
# PG_DOCKER_IMAGE se exporta en la sesión de copias (no lo carga Compose).
# Opcional: FRONTEND_IMAGE, BACKEND_IMAGE y BACKEND_URL.
