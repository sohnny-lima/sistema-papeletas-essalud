# Copie este archivo como .env y complete los valores. No versione el .env.

# Puerto HTTP del backend (el proxy de desarrollo apunta al 3000)
PORT=3000
# Opcional: origen adicional permitido por CORS en desarrollo; vacío para mismo origen.
CLIENT_URL=http://localhost:4200
# development | production | test
NODE_ENV=development

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Tiempo máximo (ms) para obtener una conexión antes de responder 503
DB_CONNECTION_TIMEOUT_MS=10000
# Solo pool de la API: sentencia, espera del cliente y transacción abandonada (ms).
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=18000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# Registro JSON de acceso sin query string, cuerpo, cabeceras ni IP.
ACCESS_LOG_ENABLED=true

# Obligatorio: el servidor no arranca sin él. Use una cadena aleatoria de 32+ caracteres.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=

# Los archivos tienen prioridad sobre DB_PASSWORD y JWT_SECRET; no se registra su valor.
DB_PASSWORD_FILE=
JWT_SECRET_FILE=
# Duración positiva de jsonwebtoken: 1h, 30m, etc. Sin renovación automática.
JWT_EXPIRES_IN=1h
# Intentos fallidos de login por IP y ventana en milisegundos (almacén en memoria).
# Los accesos correctos y las respuestas 5xx no consumen el límite.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# false por defecto. Docker con un único Nginx: 1 (backend sin acceso directo público).
# También admite IP/subredes separadas por coma. No se admite true.
TRUST_PROXY=false
# Mínimo configurable entre 10 y 72; letra + número y distinta del usuario.
PASSWORD_MIN_LENGTH=10

# Solo operaciones: secreto del rol API al ejecutar migrar.js --conceder-app rol.
# DB_USER/DB_PASSWORD_FILE deben corresponder al propietario en ese proceso.
APP_DB_PASSWORD_FILE=
